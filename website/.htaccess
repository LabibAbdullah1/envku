# ----------------------------------------------------------------------
# Konfigurasi Keamanan & Kompatibilitas Website Envku (envku.subly.my.id)
# ----------------------------------------------------------------------

# 1. Pastikan charset default UTF-8
AddDefaultCharset UTF-8

# 2. MIME Types yang tepat agar browser tidak menolak CSS, JS, SVG, Fonts
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType application/json .json
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
</IfModule>

# 3. Header CORS & Cache untuk aset statis agar selalu dimuat lancar di semua browser
<FilesMatch "\.(css|js|svg|png|jpg|jpeg|gif|webp|woff|woff2|ttf|json|ico)$">
    <IfModule mod_headers.c>
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </IfModule>
</FilesMatch>

# 4. Mencegah directory listing (agar file tidak bisa diintip dalam bentuk list folder)
Options -Indexes

# 5. Memaksa penggunaan HTTPS (enkripsi koneksi agar aman)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 6. Mencegah mesin pencari mengindeks aset internal jika diinginkan
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

